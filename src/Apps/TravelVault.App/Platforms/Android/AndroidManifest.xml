<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Security (D52): no Android cloud backup and no device-to-device copy of app data. The only backup is the
	     user's own encrypted export, unlocked by the recovery code. HTTPS only. -->
	<application
		android:allowBackup="false"
		android:fullBackupContent="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:usesCleartextTraffic="false"
		android:icon="@mipmap/appicon"
		android:roundIcon="@mipmap/appicon_round"
		android:supportsRtl="true"></application>

	<!-- Family sync through the relay, and update checks against GitHub Releases. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Travel reminders, on the minute when the user allows "Alarms & reminders". -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

	<!-- App lock with fingerprint/face or the phone's own PIN. -->
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />

	<!-- In-app updates from GitHub Releases ("Install unknown apps" is asked once). -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

	<!-- Paper tickets and invite QR codes, photographed and read on the phone. Asked only when used. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />

	<!-- "Save to phone" on Android 8–9 only (newer versions need no permission). -->
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>
