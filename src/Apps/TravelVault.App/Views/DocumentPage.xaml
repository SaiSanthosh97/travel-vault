<?xml version="1.0" encoding="utf-8" ?>
<!--
    The document as a ticket card (C-023): the parts people look for at a station or a gate come first and big
    (route, times, PNR, seat, who travels); everything else read from the ticket is folded under "More details".
-->
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TravelVault.App.Views"
             xmlns:vm="clr-namespace:TravelVault.App.ViewModels"
             xmlns:svc="clr-namespace:TravelVault.App.Services"
             xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
             x:Class="TravelVault.App.Views.DocumentPage"
             x:DataType="vm:DocumentViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="14">

            <Label Text="{Binding Warning}" TextColor="{StaticResource Warning}" IsVisible="{Binding Warning, Converter={StaticResource NotEmpty}}" />

            <!-- Possible duplicate -->
            <Border Style="{StaticResource Card}" Padding="14" IsVisible="{Binding HasDuplicate}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding DuplicateText}" />
                    <Button Text="{x:Static s:AppResources.Document_Merge}" Command="{Binding MergeCommand}" Style="{StaticResource OutlineButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ The ticket card ============ -->
            <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="0">

                    <!-- Header band: provider, service, status -->
                    <Grid BackgroundColor="{StaticResource Primary}" Padding="16,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Icon}" FontSize="30" VerticalOptions="Center" TextColor="{StaticResource OnPrimary}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding HeaderTitle}" FontFamily="OpenSansSemibold" FontSize="20" TextColor="{StaticResource OnPrimary}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding HeaderSubtitle}" FontSize="15" TextColor="{StaticResource OnPrimary}" Opacity="0.9" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Style="{StaticResource Badge}" BackgroundColor="{Binding StatusColor}" IsVisible="{Binding StatusText, Converter={StaticResource NotEmpty}}">
                            <Label Text="{Binding StatusText}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="White" />
                        </Border>
                    </Grid>

                    <!-- Legs: FROM ——— TO with big times -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Legs}" Padding="16,14,16,6" Spacing="18">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TicketLeg">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                        <!-- Start -->
                                        <VerticalStackLayout>
                                            <Label Text="{Binding FromCode}" FontFamily="OpenSansSemibold" FontSize="28" LineBreakMode="TailTruncation" MaxLines="2" />
                                            <Label Text="{Binding FromName}" Style="{StaticResource Subtle}" LineBreakMode="TailTruncation" IsVisible="{Binding FromName, Converter={StaticResource NotEmpty}}" />
                                            <Label Text="{Binding DepartTime}" FontFamily="OpenSansSemibold" FontSize="24" Margin="0,6,0,0" IsVisible="{Binding DepartTime, Converter={StaticResource NotEmpty}}" />
                                            <Label Text="{Binding DepartDate}" Style="{StaticResource Subtle}" FontSize="15" />
                                        </VerticalStackLayout>

                                        <!-- Middle: mode and travel time -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Start" Margin="0,8,0,0" IsVisible="{Binding HasEnd}" WidthRequest="84">
                                            <Label Text="{Binding ModeIcon}" FontSize="20" HorizontalOptions="Center" />
                                            <BoxView HeightRequest="2" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,2" />
                                            <Label Text="{Binding Middle}" Style="{StaticResource Subtle}" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>

                                        <!-- End -->
                                        <VerticalStackLayout Grid.Column="2" IsVisible="{Binding HasEnd}">
                                            <Label Text="{Binding ToCode}" FontFamily="OpenSansSemibold" FontSize="28" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" MaxLines="2" />
                                            <Label Text="{Binding ToName}" Style="{StaticResource Subtle}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" IsVisible="{Binding ToName, Converter={StaticResource NotEmpty}}" />
                                            <Label Text="{Binding ArriveTime}" FontFamily="OpenSansSemibold" FontSize="24" Margin="0,6,0,0" HorizontalTextAlignment="End" IsVisible="{Binding ArriveTime, Converter={StaticResource NotEmpty}}" />
                                            <Label Text="{Binding ArriveDate}" Style="{StaticResource Subtle}" FontSize="15" HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Label Text="{Binding Missing}" TextColor="{StaticResource Warning}" FontSize="15" IsVisible="{Binding HasMissing}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Perforation -->
                    <Grid HeightRequest="2" Margin="0,10" IsClippedToBounds="True" IsVisible="{Binding Chips.Count, Converter={StaticResource Any}}">
                        <Line X1="0" Y1="1" X2="3000" Y2="1" StrokeThickness="2" StrokeDashArray="3,3"
                              Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    </Grid>

                    <!-- Strip: PNR, coach, berth/seat, class, gate… -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding Chips}" Wrap="Wrap" JustifyContent="Start" Padding="16,4,16,8"
                                IsVisible="{Binding Chips.Count, Converter={StaticResource Any}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TicketChip">
                                <!-- Two per row, so the strip reads as a tidy grid: PNR | Coach, Berth | Class -->
                                <VerticalStackLayout FlexLayout.Basis="50%" Margin="0,0,8,12">
                                    <Label Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="12" CharacterSpacing="1" />
                                    <Label Text="{Binding Value}" FontFamily="OpenSansSemibold" FontSize="20">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Check}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Passengers -->
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <Grid ColumnDefinitions="*,Auto" Padding="16,6,8,0">
                        <Label Text="{x:Static s:AppResources.Ticket_Passengers}" Style="{StaticResource Subtle}" FontSize="12" CharacterSpacing="1" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{x:Static s:AppResources.Common_Change}" Style="{StaticResource LinkButton}" Command="{Binding TravelersCommand}" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Passengers}" Padding="16,0,16,14" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PassengerLine">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding Status}" Style="{StaticResource Subtle}" FontSize="15" IsVisible="{Binding HasStatus}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Main actions -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{x:Static s:AppResources.Document_View}" Command="{Binding ViewCommand}" />
                <Button Grid.Column="1" Text="{x:Static s:AppResources.Document_Barcode}" Command="{Binding BarcodeCommand}" Style="{StaticResource OutlineButton}" IsVisible="{Binding CanShowBarcode}" />
            </Grid>

            <!-- More details (folded) -->
            <Border Style="{StaticResource Card}" Padding="14,4" IsVisible="{Binding Fields.Count, Converter={StaticResource Any}}">
                <VerticalStackLayout>
                    <Button Text="{Binding MoreText}" Style="{StaticResource LinkButton}" HorizontalOptions="Start" Command="{Binding ToggleMoreCommand}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="6" Padding="0,0,0,10" IsVisible="{Binding ShowMore}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FieldRow">
                                <Grid ColumnDefinitions="2*,3*" ColumnSpacing="8">
                                    <Label Text="{Binding Label}" Style="{StaticResource Subtle}" />
                                    <Label Grid.Column="1" Text="{Binding Value}" FontFamily="OpenSansSemibold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Check}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Boarding passes linked to this ticket -->
            <Label Text="{x:Static s:AppResources.Document_BoardingPasses}" Style="{StaticResource SectionLabel}" IsVisible="{Binding BoardingPasses.Count, Converter={StaticResource Any}}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding BoardingPasses}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:DocumentRow">
                        <views:DocumentRowView Row="{Binding .}" Command="{Binding OpenPassCommand, Source={RelativeSource AncestorType={x:Type vm:DocumentViewModel}}, x:DataType=vm:DocumentViewModel}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Trip and files -->
            <Border Style="{StaticResource Card}" Padding="14,6">
                <VerticalStackLayout Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{x:Static s:AppResources.Document_TripTitle}" Style="{StaticResource Subtle}" FontSize="13" />
                            <Label Text="{Binding TripText}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{x:Static s:AppResources.Common_Change}" Style="{StaticResource LinkButton}" Command="{Binding TripCommand}" />
                    </Grid>
                    <BoxView HeightRequest="1" Margin="0,6" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <Label Text="{x:Static s:AppResources.Document_Files}" Style="{StaticResource Subtle}" FontSize="13" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}" Spacing="4" Padding="0,0,0,6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Text}" FontSize="15" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenFileCommand, Source={RelativeSource AncestorType={x:Type vm:DocumentViewModel}}, x:DataType=vm:DocumentViewModel}" CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Button Grid.Column="1" Text="{x:Static s:AppResources.Document_MakePrimary}" Style="{StaticResource LinkButton}"
                                            Command="{Binding MakePrimaryCommand, Source={RelativeSource AncestorType={x:Type vm:DocumentViewModel}}, x:DataType=vm:DocumentViewModel}" CommandParameter="{Binding .}"
                                            IsVisible="{Binding IsPrimary, Converter={StaticResource Not}}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Other actions -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" Margin="0,4,0,0">
                <Button Text="{x:Static s:AppResources.Document_Edit}" Command="{Binding EditCommand}" Style="{StaticResource OutlineButton}" />
                <Button Grid.Column="1" Text="{x:Static s:AppResources.Document_Share}" Command="{Binding ShareCommand}" Style="{StaticResource OutlineButton}" />
                <Button Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static s:AppResources.Document_Save}" Command="{Binding SaveCommand}" Style="{StaticResource OutlineButton}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanMakePrivate}">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="{x:Static s:AppResources.Document_Private}" />
                    <Label Text="{x:Static s:AppResources.Document_PrivateHelp}" Style="{StaticResource Subtle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{x:Static s:AppResources.Common_Change}" Style="{StaticResource LinkButton}" Command="{Binding TogglePrivateCommand}" />
            </Grid>
            <Label Text="{x:Static s:AppResources.Document_IsPrivate}" Style="{StaticResource Subtle}" IsVisible="{Binding IsPrivate}" />
            <Button Text="{x:Static s:AppResources.Common_Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</views:VaultPage>
