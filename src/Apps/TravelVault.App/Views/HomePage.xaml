<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TravelVault.App.Views"
             xmlns:vm="clr-namespace:TravelVault.App.ViewModels"
             xmlns:svc="clr-namespace:TravelVault.App.Services"
             xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
             x:Class="TravelVault.App.Views.HomePage"
             x:DataType="vm:HomeViewModel"
            
             Title="{x:Static s:AppResources.AppName}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,96" Spacing="12">

                    <!-- No family yet -->
                    <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding NoFamily}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{x:Static s:AppResources.Home_StartTitle}" Style="{StaticResource Heading}" />
                            <Label Text="{x:Static s:AppResources.Home_StartText}" />
                            <Button Text="{x:Static s:AppResources.Family_Create}" Command="{Binding CreateFamilyCommand}" />
                            <Button Text="{x:Static s:AppResources.Family_Join}" Command="{Binding JoinFamilyCommand}" Style="{StaticResource OutlineButton}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Family + sync status -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasFamily}">
                        <VerticalStackLayout>
                            <Label Text="{Binding FamilyName}" Style="{StaticResource Heading}" />
                            <Label Text="{Binding SyncStatus}" Style="{StaticResource Subtle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="{x:Static s:AppResources.Home_Switch}" Style="{StaticResource LinkButton}"
                                Command="{Binding SwitchFamilyCommand}" IsVisible="{Binding ManyFamilies}" VerticalOptions="Center" />
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding Removed}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{x:Static s:AppResources.Family_RemovedText}" TextColor="{StaticResource Danger}" />
                            <Button Text="{x:Static s:AppResources.Family_DeleteData}" Style="{StaticResource DangerButton}" Command="{Binding DeleteRemovedFamilyCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Journey flash cards (D66): one per upcoming or ongoing trip, swiped sideways -->
                    <Label Text="{x:Static s:AppResources.Home_YourJourneys}" Style="{StaticResource SectionLabel}" IsVisible="{Binding HasCards}" />
                    <CollectionView ItemsSource="{Binding Cards}" IsVisible="{Binding HasCards}" HeightRequest="250" Margin="-16,0">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" SnapPointsType="MandatorySingle" SnapPointsAlignment="Center" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Header>
                            <BoxView WidthRequest="4" Color="Transparent" />
                        </CollectionView.Header>
                        <CollectionView.Footer>
                            <BoxView WidthRequest="4" Color="Transparent" />
                        </CollectionView.Footer>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:JourneyCard">
                                <Border WidthRequest="320" Padding="18,16" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCardCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="2">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="22" LineBreakMode="TailTruncation" MaxLines="1"
                                               TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                        <Label Grid.Row="1" Text="{Binding Summary}" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                            <Label Text="{Binding Icon}" FontSize="38" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding NextLabel}" FontSize="12" FontFamily="OpenSansSemibold" IsVisible="{Binding NextLabel, Converter={StaticResource NotEmpty}}"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" Opacity="0.85" />
                                                <Label Text="{Binding NextRoute}" FontFamily="OpenSansSemibold" FontSize="19" MaxLines="2" LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                                <Label Text="{Binding NextWhen}" FontSize="16"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Label Grid.Row="3" Text="{Binding NextDetails}" FontSize="14" MaxLines="2" LineBreakMode="TailTruncation" Opacity="0.9"
                                               TextColor="{AppThemeBinding Light={StaticResource OnPrimary}, Dark={StaticResource OnPrimaryDark}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="{x:Static s:AppResources.Home_Empty}" Style="{StaticResource Subtle}" IsVisible="{Binding IsEmpty}" />

                    <!-- Trip suggestions -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SuggestionRow">
                                <Border Style="{StaticResource Card}" Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Text}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Text="{x:Static s:AppResources.Home_GroupTrip}" Command="{Binding ConfirmSuggestionCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" CommandParameter="{Binding .}" />
                                            <Button Grid.Column="1" Text="{x:Static s:AppResources.Common_NotNow}" Style="{StaticResource OutlineButton}"
                                                    Command="{Binding DismissSuggestionCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Add a document -->
        <Button Text="＋" FontSize="34" WidthRequest="68" HeightRequest="68" CornerRadius="34" Padding="0"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,20"
                Command="{Binding AddCommand}" IsVisible="{Binding HasFamily}"
                SemanticProperties.Description="{x:Static s:AppResources.Add_Title}" />
    </Grid>
</views:VaultPage>
