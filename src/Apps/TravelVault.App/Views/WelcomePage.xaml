<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelVault.App.ViewModels"
             xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
             x:Class="TravelVault.App.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,48,24,32" Spacing="16">
                <Label Text="🧳" FontSize="56" HorizontalOptions="Center" />
                <Label Text="{x:Static s:AppResources.AppName}" Style="{StaticResource Heading}" FontSize="30" HorizontalOptions="Center" />
                <Label Text="{x:Static s:AppResources.Welcome_Pitch}" HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding KeyLost}">
                    <Label Text="{x:Static s:AppResources.Welcome_KeyLost}" TextColor="{StaticResource Danger}" />
                </Border>

                <Label Text="{x:Static s:AppResources.Welcome_YourName}" Style="{StaticResource SectionLabel}" />
                <Entry Text="{Binding Name}" Placeholder="{x:Static s:AppResources.Welcome_NamePlaceholder}" MaxLength="40" ReturnCommand="{Binding CreateCommand}" />
                <Label Text="{x:Static s:AppResources.Welcome_NameHelp}" Style="{StaticResource Subtle}" />
                <Button Text="{x:Static s:AppResources.Welcome_Start}" Command="{Binding CreateCommand}" Margin="0,8,0,0" />

                <Label Text="{x:Static s:AppResources.Welcome_NewPhone}" Style="{StaticResource SectionLabel}" Margin="0,24,0,0" />
                <Button Text="{x:Static s:AppResources.Welcome_Restore}" Command="{Binding RestoreCommand}" Style="{StaticResource OutlineButton}" />
                <Label Text="{x:Static s:AppResources.Welcome_Privacy}" Style="{StaticResource Subtle}" Margin="0,16,0,0" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
