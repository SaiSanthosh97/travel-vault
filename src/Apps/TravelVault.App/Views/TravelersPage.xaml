<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TravelVault.App.Views"
             xmlns:vm="clr-namespace:TravelVault.App.ViewModels"
             xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
             x:Class="TravelVault.App.Views.TravelersPage"
             x:DataType="vm:TravelersViewModel"
             Title="{x:Static s:AppResources.Travelers_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="10">
            <Label Text="{x:Static s:AppResources.Travelers_Help}" Style="{StaticResource Subtle}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Travelers}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TravelerRow">
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:TravelersViewModel}}, x:DataType=vm:TravelersViewModel}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Details}" Style="{StaticResource Subtle}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="{x:Static s:AppResources.Travelers_Add}" Command="{Binding AddCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:VaultPage>
