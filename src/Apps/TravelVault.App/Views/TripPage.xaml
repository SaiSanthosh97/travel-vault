<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TravelVault.App.Views"
             xmlns:vm="clr-namespace:TravelVault.App.ViewModels"
             xmlns:svc="clr-namespace:TravelVault.App.Services"
             xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
             x:Class="TravelVault.App.Views.TripPage"
             x:DataType="vm:TripViewModel"
             Title="{Binding Name}">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="12">
            <Label Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="26" />
            <Label Text="{Binding Dates}" />
            <Label Text="{Binding StatusText}" Style="{StaticResource Subtle}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Documents}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:DocumentRow">
                        <views:DocumentRowView Row="{Binding .}" Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:TripViewModel}}, x:DataType=vm:TripViewModel}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="{x:Static s:AppResources.Trip_Rename}" Command="{Binding RenameCommand}" Style="{StaticResource OutlineButton}" Margin="0,12,0,0" />
            <Button Text="{x:Static s:AppResources.Trip_Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</views:VaultPage>
