<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TravelVault.App.Views"
             xmlns:vm="clr-namespace:TravelVault.App.ViewModels"
             xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
             x:Class="TravelVault.App.Views.RecoveryCodePage"
             x:DataType="vm:RecoveryCodeViewModel"
             Title="{x:Static s:AppResources.Recovery_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="14">
            <Label Text="{x:Static s:AppResources.Recovery_Intro}" />
            <Border Style="{StaticResource Card}" Padding="20">
                <Label Text="{Binding Code}" FontFamily="OpenSansSemibold" FontSize="24" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            </Border>
            <Label Text="{x:Static s:AppResources.Recovery_Keep}" Style="{StaticResource Subtle}" />
            <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                <CheckBox IsChecked="{Binding WrittenDown}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{x:Static s:AppResources.Recovery_WrittenDown}" VerticalOptions="Center" />
            </Grid>
            <Button Text="{x:Static s:AppResources.Common_Done}" Command="{Binding DoneCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</views:VaultPage>
