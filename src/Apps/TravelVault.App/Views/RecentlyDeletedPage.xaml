<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TravelVault.App.Views"
             xmlns:vm="clr-namespace:TravelVault.App.ViewModels"
             xmlns:svc="clr-namespace:TravelVault.App.Services"
             xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
             x:Class="TravelVault.App.Views.RecentlyDeletedPage"
             x:DataType="vm:RecentlyDeletedViewModel"
             Title="{x:Static s:AppResources.Deleted_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="10">
            <Label Text="{x:Static s:AppResources.Deleted_Help}" Style="{StaticResource Subtle}" />
            <Label Text="{x:Static s:AppResources.Deleted_Empty}" IsVisible="{Binding IsEmpty}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Documents}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="svc:DocumentRow">
                        <views:DocumentRowView Row="{Binding .}" Command="{Binding RestoreCommand, Source={RelativeSource AncestorType={x:Type vm:RecentlyDeletedViewModel}}, x:DataType=vm:RecentlyDeletedViewModel}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:VaultPage>
