<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelVault.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TravelVault.App.Views"
    xmlns:s="clr-namespace:TravelVault.App.Resources.Strings"
    Title="{x:Static s:AppResources.AppName}"
    FlyoutBehavior="Disabled">

    <!-- Start: decides between first-launch setup, the lock screen and the main tabs. -->
    <ShellContent Route="start" ContentTemplate="{DataTemplate views:StartPage}" Shell.NavBarIsVisible="False" />
    <ShellContent Route="welcome" ContentTemplate="{DataTemplate views:WelcomePage}" Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent Title="{x:Static s:AppResources.Tab_Home}" Route="home" ContentTemplate="{DataTemplate views:HomePage}">
            <ShellContent.Icon><FontImageSource Glyph="🏠" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Trips}" Route="trips" ContentTemplate="{DataTemplate views:TripsPage}">
            <ShellContent.Icon><FontImageSource Glyph="🧳" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Search}" Route="search" ContentTemplate="{DataTemplate views:SearchPage}">
            <ShellContent.Icon><FontImageSource Glyph="🔍" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Family}" Route="family" ContentTemplate="{DataTemplate views:FamilyPage}">
            <ShellContent.Icon><FontImageSource Glyph="👥" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Settings}" Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon><FontImageSource Glyph="⚙" Size="22" /></ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
